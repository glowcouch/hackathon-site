---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import coding_photo from "../assets/coding-photo.jpg";
import HSection from "../components/HSection.astro";
import { event } from "../data/data.ts";
---

<HSection id="about" title="Student run, made for high-schoolers">
	<div class="lg:grid lg:grid-cols-2 lg:gap-10">
		<div class="space-y-8">
			<!-- 1. What it is -->
			<p class="text-xl">
				12 hours to make something cool, meet new people, learn something, and
				have fun. The challenge is revealed on the day 🤫
			</p>

			<!-- 2. Key facts as a real list -->
			<dl class="grid gap-3 text-lg">
				<div class="flex gap-3">
					<dt class="font-semibold min-w-24">Date</dt>
					<dd class="text-accent">Saturday, 27 February 2027</dd>
				</div>
				<div class="flex gap-3">
					<dt class="font-semibold min-w-24">Time</dt>
					<dd class="text-accent">9:00 am</dd>
				</div>
				<div class="flex gap-3">
					<dt class="font-semibold min-w-24">Location</dt>
					<dd class="text-accent">148 Durham Street, Tauranga 3110</dd>
				</div>
			</dl>

			<!-- 3. Reassurances, grouped and quieter -->
			<ul class="text-muted">
				<li>Completely free - open to ages 13 to 18.</li>
			</ul>

			<!-- 4. CTA -->
			<div class="flex justify-center md:block md:justify-normal">
				<a href="/hackathon.ics" download class="btn btn-lg btn-outline">
					<Icon name="lucide:calendar" class="size-5" />
					Add to calendar
				</a>
			</div>
		</div>
		<div class="h-full w-full my-10 lg:my-0">
			<Picture
				src={coding_photo}
				alt={`Teens coding at ${event.venue}`}
				formats={["avif", "webp"]}
				fallbackFormat="jpeg"
				widths={[361, 651, 925, 1400, 1850]}
				sizes="(min-width: 1024px) 90vw, 100vw"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="w-full h-full object-cover object-[50%_20%]"
			/>
		</div>
	</div>
</HSection>
