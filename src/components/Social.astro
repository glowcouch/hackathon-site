---
import { Icon } from "astro-icon/components";

const { icon, handle, subtitle } = Astro.props;
const handle_base64 = btoa(handle);
---

<div class="card card-side bg-base-300 hover:bg-base-200 w-full">
	<figure class="pl-[24px]">
		<Icon name={icon} class="size-10 text-primary" />
	</figure>
	<div class="card-body">
		<h2 class="card-title text-2xl social-handle" data-encoded={handle_base64}>
			<span class="invisible">loading</span>
		</h2>
		<p class="text-lg">{subtitle}</p>
	</div>
</div>

<script>
document
	.querySelectorAll<HTMLAnchorElement>(".social-handle")
	.forEach((handle) => {
		const encoded = handle.dataset.encoded;
		if (!encoded) return;

		console.log(encoded);
		const handle_decrypted = atob(encoded);
		handle.textContent = handle_decrypted;
	});
</script>
