---
import { Icon } from "astro-icon/components";

const sizes = {
	4: "size-4 md:size-5",
	5: "size-5 md:size-6",
	6: "size-6 md:size-8",
	8: "size-8 md:size-10",
	10: "size-10 md:size-12",
	12: "size-12 md:size-14",
} as const;

const { size = 6, class: classes } = Astro.props as {
	size?: keyof typeof sizes;
	class: string;
};
const sizeClass = sizes[size];
---

<div class="relative inline-block text-4xl font-bold">
	<Icon
		name="lucide:sparkles"
		class={`absolute right-full -mr-1 -mt-1 top-full md:top-auto md:bottom-0 md:mr-2 md:mt-0 ${sizeClass} text-accent ${classes}`}
	/>
	<slot />
	<Icon
		name="lucide:sparkles"
		class={`absolute left-full -ml-1 -mb-1 bottom-full md:bottom-auto md:-top-[0.3em] md:ml-2 md:mb-0 ${sizeClass} text-accent ${classes}`}
	/>
</div>
