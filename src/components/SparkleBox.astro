---
import { Icon } from "astro-icon/components";

const sizes = {
	4: "size-4",
	5: "size-5",
	6: "size-6",
	8: "size-8",
	10: "size-10",
	12: "size-12",
} as const;

const { size = 6, class: classes } = Astro.props as {
	size?: keyof typeof sizes;
	class: string;
};
const sizeClass = sizes[size];
---

<div class="relative inline-block text-4xl font-bold">
	<Icon
		name="lucide:sparkles"
		class={`absolute right-full mr-2 bottom-0 ${sizeClass} text-accent ${classes}`}
	/>
	<slot />
	<Icon
		name="lucide:sparkles"
		class={`absolute left-full ml-2 -top-[0.3em] ${sizeClass} text-accent ${classes}`}
	/>
</div>
