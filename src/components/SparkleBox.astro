---
import { Icon } from "astro-icon/components";

const { size } = Astro.props;
---

<div class="relative inline-block text-4xl font-bold">
	<Icon
		name="lucide:sparkles"
		class={`absolute -left-[0.7em] bottom-0 size-${size} text-accent`}
	/>
	<slot />
	<Icon
		name="lucide:sparkles"
		class={`absolute -right-[0.8em] -top-[0.3em] size-${size} text-accent`}
	/>
</div>
