---
import HSection from "../components/HSection.astro";
import { team } from "../data/team.ts";
import Profile from "./Profile.astro";
---

<HSection title="Our team:" id="team">
	<div class="carousel carousel-left lg:carousel-center space-x-4  w-full">
		{team.map((member) => (
			<Profile
				name={member.name}
				imgsrc={member.imgsrc}
				imgalt={member.name}
				class="carousel-item w-95/100"
			>
				<member.writeup />
			</Profile>
		))}
	</div>
</HSection>
