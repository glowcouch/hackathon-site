---
import HSection from "../components/HSection.astro";
import { team } from "../data/team.ts";
import Profile from "./Profile.astro";
---

<HSection title="Our team:">
	<div
		class="carousel carousel-left lg:carousel-center space-x-4 h-[90vh] md:h-[70vh] lg:h-[50vh] w-full"
	>
		{team.map((member) => (
			<Profile
				name={member.name}
				imgsrc={member.imgsrc}
				imgalt={member.name}
				class="carousel-item w-90/100"
			>
				<member.writeup />
			</Profile>
		))}
	</div>
</HSection>
