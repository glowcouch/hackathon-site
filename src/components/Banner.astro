---
const { heading, subheading } = Astro.props;

import { event } from "../data/data.ts";
---

<header role="banner">
	<div class="relative overflow-clip py-24 h-[60vh]">
		<div
			class:list={[
				"absolute",
				// pin to edges
				"inset-x-0",
				// center vertically
				"top-1/2 -translate-y-1/2",
				// rotate
				"-rotate-3",
				// overscale slightly so it covers everything
				"scale-110",
				// scale smaller than parent
				"h-3/4",
				// color
				"bg-primary/80 better-glass",
				// center the content
				"flex justify-center",
			]}
		>
			<div
				class:list={[
					// scale down so it's the width of the screen
					"w-[100vw]",
					// center the content
					"flex justify-center items-center",
				]}
			>
				<div class="text-center text-shadow-lg">
					<h1 class="text-[11vw]">
						{heading}
					</h1>
					<h2 class="text-[6vw]">
						{subheading}
					</h2>
					<br>
					<a class="btn btn-secondary" href={event.signUp}>Sign Up!</a>
				</div>
			</div>
		</div>
	</div>
</header>
