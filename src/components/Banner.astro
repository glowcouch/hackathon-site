---
const { heading, subheading } = Astro.props;

import { event } from "../data/data.ts";

import SparkleBox from "./SparkleBox.astro";
---

<header>
	<div class="relative overflow-clip py-24 h-[60vh] my-20">
		<div
			class:list={[
				"absolute",
				// pin to edges
				"inset-x-0",
				// center vertically
				"top-1/2 -translate-y-1/2",
				// rotate
				"-rotate-3",
				// overscale slightly so it covers everything
				"scale-110",
				// scale smaller than parent
				"h-3/4",
				// color
				"bg-primary/80 better-glass",
				// center the content
				"flex justify-center",
			]}
		>
			<div
				class:list={[
					// scale down so it's the width of the screen
					"w-[100vw]",
					// center the content
					"flex justify-center items-center",
				]}
			>
				<div class="text-center text-shadow-lg">
					<SparkleBox size="[10em]" class="drop-shadow-lg">
						<h1 class="text-[13.5vw] lg:text-9xl text-accent">
							{heading}
						</h1>
					</SparkleBox>
					<h2 class="text-[4.5vw] lg:text-6xl text-nowrap">
						{subheading}
					</h2>
					<br>
					<a class="btn btn-accent lg:btn-xl md:btn-lg" href={event.signUp}
						>Sign Up!</a
					>
				</div>
			</div>
		</div>
	</div>
</header>
