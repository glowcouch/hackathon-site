---
const { name, imgsrc, imgalt } = Astro.props;
---

<div class="card bg-base-300 w-full md:w-100 shadow-sm">
	<figure>
		<div class="avatar">
			<div class="">
				<img src={imgsrc} alt={imgalt}>
			</div>
		</div>
	</figure>
	<div class="card-body text-3xl">
		<h2 class="card-title text-4xl">{name}</h2>
		<slot />
	</div>
</div>
