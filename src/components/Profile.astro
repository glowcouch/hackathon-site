---
const { name, imgsrc, imgalt, class: classes } = Astro.props;
---

<div class={`card md:card-side bg-base-300 ${classes}`}>
	<figure class="shrink-0">
		<img
			src={imgsrc}
			alt={imgalt}
			class="aspect-[4/3] w-full object-cover md:aspect-square lg:h-full"
		>
	</figure>
	<div class="card-body text-2xl">
		<h2 class="card-title text-4xl">{name}</h2>
		<slot />
	</div>
</div>
