---
const { name, imgsrc, imgalt } = Astro.props;
---

<div class="card bg-base-200 w-full md:w-96 shadow-sm">
	<figure>
		<div class="avatar">
			<div class="">
				<img src={imgsrc} alt={imgalt}>
			</div>
		</div>
	</figure>
	<div class="card-body">
		<h2 class="card-title">{name}</h2>
		<slot />
	</div>
</div>
