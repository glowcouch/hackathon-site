---
// src/components/SparkleDivider.astro
import { Icon } from "astro-icon/components";

interface Props {
	/** Overrides DEFAULT_SEED; use a different one per divider for a different layout */
	seed?: number;
}

// ---- tuning ----
const DEFAULT_SEED = 7;
const ICONS = ["lucide:sparkle", "lucide:sparkles"]; // picked from at random
const SPACING = 400; // px between sparkles (smaller = denser)
const HEIGHT = 16; // px
const MAX_WIDTH = 2400; // px; widest parent you want covered
const SIZE = 50; // px
const COLOR = "var(--color-accent)"; // any CSS color
// ----------------

const { seed = DEFAULT_SEED } = Astro.props;

// small seeded PRNG so the layout is stable between builds
function mulberry32(a: number) {
	return () => {
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(seed);

const cols = Math.ceil(MAX_WIDTH / SPACING) + 1;

const sparkles = Array.from({ length: cols }, (_, col) => {
	const icon = ICONS[Math.floor(rand() * ICONS.length)];
	const x = (col - (cols - 1) / 2) * SPACING; // px offset from the horizontal center

	return {
		icon,
		x,
		// parent width at or below which this sparkle would touch an edge
		reach: Math.ceil(2 * (Math.abs(x) + SIZE / 2)),
		rotation: (1 + Math.floor(rand() * 3)) * 90,
	};
});

// one rule per distinct reach; sparkles are symmetric so pairs share a rule
const hideRules = [...new Set(sparkles.map((s) => s.reach))]
	.map(
		(r) =>
			`@container (width <= ${r}px){.sparkle-divider .r${r}{display:none}}`,
	)
	.join("");
---

<style is:global set:html={hideRules} />

<div
	role="separator"
	class="sparkle-divider my-35"
	style={`height:${HEIGHT}px;color:${COLOR}`}
>
	{sparkles.map((s) => (
		<Icon
			name={s.icon}
			class={`r${s.reach}`}
			width={SIZE}
			height={SIZE}
			style={`position:absolute;translate:-50% -50%;rotate:${s.rotation}deg;left:calc(50% + ${s.x}px);top:${HEIGHT / 2}px`}
		/>
	))}
</div>

<style>
.sparkle-divider {
	position: relative;
	/* fill the parent; needed because size containment removes the element's own intrinsic width */
	width: 100%;
	min-width: 0;
	align-self: stretch;
	container-type: inline-size;
}
</style>
