---
// src/components/SparkleDivider.astro
import { Icon } from "astro-icon/components";

// ---- tuning ----
const ICON = "logo";
const SPACING = 300; // px between sparkles
const SIZE = 100; // px
// ----------------

// left, center, right; only the center one shows below md
const offsets = [-1, 0, 1].map((pos) => ({
	x: pos * SPACING, // px offset from the horizontal center
	hideOnMobile: pos !== 0,
}));
---

<div class="relative w-full h-50 lg:h-70">
	{offsets.map((o) => (
		<Icon
			name={ICON}
			width={SIZE}
			height={SIZE}
			class:list={[
				"absolute top-1/2 -translate-x-1/2 -translate-y-1/2",
				"opacity-50",
				{ "max-md:hidden": o.hideOnMobile },
			]}
			style={`left:calc(50% + ${o.x}px)`}
		/>
	))}
</div>
