---
import { Icon } from "astro-icon/components";
import { event } from "../data/data.ts";

const links = [
	{ href: "#intro", label: "Intro" },
	{ href: "#team", label: "Our Team" },
	{ href: "#sponsors", label: "Sponsors" },
	{ href: "#faq", label: "FAQ" },
	{ href: "#contact", label: "Contact" },
];
---

<nav class="md:sticky md:top-0 z-50">
	<div class="max-lg:collapse bg-base-300 shadow-sm w-full rounded-md">
		<input id="navbar-1-toggle" class="peer hidden" type="checkbox">
		<label
			for="navbar-1-toggle"
			class="fixed inset-0 hidden max-lg:peer-checked:block"
			><span class="sr-only">Menu</span></label
		>
		<div class="collapse-title navbar">
			<div class="navbar-start">
				<label for="navbar-1-toggle" class="btn btn-ghost lg:hidden">
					<svg
						aria-label="Menu"
						xmlns="http://www.w3.org/2000/svg"
						class="h-5 w-5"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h8m-8 6h16"
						/>
					</svg>
					<span class="sr-only">Open menu</span>
				</label>
				<a class="btn btn-ghost text-4xl text-accent font-mono" href="/">
					<Icon name="logo" class="mr-4"></Icon>
					{event.name}
				</a>
			</div>
			<div class="navbar-center hidden lg:flex">
				<ul class="menu menu-horizontal px-1">
					{links.map((link) => (
						<li>
							<a href={link.href} data-nav-link class="btn btn-ghost text-xl">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div class="navbar-end"></div>
		</div>

		<div class="collapse-content lg:hidden z-1">
			<ul class="menu">
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							data-nav-link
							aria-label={link.label}
							class="btn btn-ghost text-xl"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</nav>

<script>
const links = document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]");

const ids = [
	...new Set([...links].map((l) => l.getAttribute("href")!.slice(1))),
];
const sections = ids
	.map((id) => document.getElementById(id))
	.filter((el): el is HTMLElement => el !== null);

function setActive(id: string) {
	links.forEach((link) => {
		const active = link.getAttribute("href") === `#${id}`;
		link.classList.toggle("btn-active", active);
		if (active)
			link.setAttribute("class", "btn btn-ghost text-xl text-primary");
		else link.setAttribute("class", "btn btn-ghost text-xl");
	});
}

const observer = new IntersectionObserver(
	(entries) => {
		for (const entry of entries) {
			if (entry.isIntersecting) setActive(entry.target.id);
		}
	},
	{ rootMargin: "-50% 0px -50% 0px" },
);

sections.forEach((s) => {
	observer.observe(s);
});
</script>
